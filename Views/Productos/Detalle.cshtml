@model Producto

@{
    ViewData["Title"] = "Detalle del producto";
}

<h1>@Model.Nombre</h1>

@if (ViewBag.EsPremium)
{
    <span class="badge bg-warning text-dark mb-3 fs-6">Producto Premium</span>
}

<dl class="row mt-4">
    <dt class="col-sm-3">Id</dt>
    <dd class="col-sm-9">@Model.Id</dd>

    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>

    <dt class="col-sm-3">Descripcion</dt>
    <dd class="col-sm-9">@Model.Descripcion</dd>

    <dt class="col-sm-3">Precio</dt>
    <dd class="col-sm-9">₡@Model.Precio</dd>

    <dt class="col-sm-3">Categoria</dt>
    <dd class="col-sm-9">@Model.Categoria</dd>

    <dt class="col-sm-3">Disponible</dt>
    <dd class="col-sm-9">@(Model.Disponible ? "Si" : "No")</dd>
</dl>

<a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
